# Configuration for the GPT-free variant (branch variant/no-ai).
#
# Copy to .env and fill in. Every value below is this deployment's own; none of
# them may be copied from the live system. The variant and the original run in
# the same GCP project, so a shared bucket or database name is the one mistake
# that silently merges the two products' data.
#
# In Cloud Run this file is not used directly: the bot downloads it from Secret
# Manager at boot (api/secret/secret.go) using GCP_ENV_SECRET_NAME. Keep this
# file and the secret's contents in step.

# ---------------------------------------------------------------- LINE channel
# Messaging API channel secret. LINE Developers console > your Messaging API
# channel > Basic settings. SECRET - leave blank here, fill in .env only.
LINE_CHANNEL_SECRET=
# Messaging API long-lived channel access token, same console page.
# SECRET - leave blank here.
LINE_CHANNEL_TOKEN=
# LINE Login channel ID the LIFF app belongs to. ID tokens name it as their
# audience, so it is what proves a token was issued for this app. It is the part
# of the LIFF ID before the dash.
LINE_LOGIN_CHANNEL_ID=

# -------------------------------------------------------------------- Google Cloud
# GCP project the variant's resources live in. `gcloud config get-value project`.
GCP_PROJECT_ID=
# Service account the Cloud Run services run as, and the signer for playback
# URLs: on Cloud Run the metadata credentials carry no private key, so signing
# goes through IAM and has to be told which account it is signing as.
GCP_SERVICE_ACCOUNT_EMAIL=
# Service account JSON, for running the bot outside Cloud Run only. On Cloud Run
# leave this empty and let the metadata server provide credentials.
# SECRET - leave blank here.
GCP_CREDENTIALS=
# Secret Manager secret holding this deployment's .env, downloaded at boot.
# Must NOT be the live deployment's secret. Create it with the command in
# README.md; suggested name: 2025-linebot-noai-env.
GCP_ENV_SECRET_NAME=
# Optional pin for a specific version of that secret; blank means latest.
GCP_SECRET_VERSION=

# --------------------------------------------------------------------- Storage
# The variant's own GCS bucket for practice video, renders and expert clips.
# Must NOT be the live bucket. Create it with the command in README.md;
# suggested name: nstc-2025-storage-noai.
GCS_BUCKET_NAME=

# -------------------------------------------------------------------- Firestore
# The variant's own Firestore databases. Must NOT be the live databases. Create
# them with the commands in README.md.
# Portfolios, scores and weekly reflections.
FIREBASE_DATA_DB=
# Per-learner conversation state for the LINE flows.
FIREBASE_SESSION_DB=

# ------------------------------------------------------- Analysis gRPC service
# host:port of the pose-analysis service, without the https:// scheme. The bot's
# deploy workflow fills this in from `gcloud run services describe`.
ANALYSIS_GRPC_TARGET=
# Shared API key the analysis service checks on every call.
# SECRET - leave blank here; comes from Secret Manager.
ANALYSIS_GRPC_API_KEY=
# TLS off. Only ever true against a local service; Cloud Run is always false.
ANALYSIS_GRPC_INSECURE=false

# -------------------------------------------------------------------- Web app
# Where the bot sends learners to write their weekly reflection. The variant's
# own Netlify site, never the live one. There is deliberately no default: an
# unset value would otherwise hand learners the other deployment's web app.
LIFF_REVIEW_URL=

# ---------------------------------------------------------------------- Server
# Port the bot listens on. Cloud Run sets this itself.
PORT=8080

# =============================================================================
# Analysis service (badminton_analysis_ai). Set on that Cloud Run service, not
# in the bot's .env. Listed here so every variable the variant needs is in one
# place.
# =============================================================================
# GCP_PROJECT_ID, GCS_BUCKET_NAME, GCP_SERVICE_ACCOUNT_EMAIL and
# ANALYSIS_GRPC_API_KEY as above, plus:
#
# How long a playback URL stays valid, in minutes (1-10080).
# SIGNED_URL_MINUTES=60
# Largest upload the service will accept, in bytes.
# MAX_VIDEO_BYTES=157286400
# Torch device for the EIMD diffusion prior: auto, cuda or cpu.
# EXPERT_MOTION_DEVICE=auto
# Where the prebuilt RF-DETR TensorRT engines are baked into the image.
# BADMINTON_TRT_CACHE_DIR=/app/models/trt-engines

# =============================================================================
# Web app build (liff). Set in the CD workflow's environment, not in this file.
# =============================================================================
# The variant's own bot, as a full https:// URL.
# NEXT_PUBLIC_BACKEND_BASE_URL=
# The variant's own LIFF ID, "<login channel id>-<suffix>".
# NEXT_PUBLIC_LIFF_ID=
