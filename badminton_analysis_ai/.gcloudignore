# Files and directories to exclude from upload to Cloud Build.
# gcloud reads this file instead of .gitignore.

# VCS and editor junk
.git
.DS_Store

# Python caches and venvs
__pycache__/
.venv/

# Large or generated artifacts we don't need in the image
output/
expert_videos/
test_videos/
validation/
*.log
logs/
