# The RF-DETR TensorRT engine baked into the GPU image, published as a generic
# artifact in Artifact Registry. build_rfdetr_engine.py uploads it and
# .github/workflows/cd-motion-analysis.yml downloads it; both read this file.
#
# An engine only runs on the GPU architecture, TensorRT and RF-DETR versions it
# was built with, so the version names all three. Change the version (and
# trt-engines.sha256) whenever any of them changes, then rebuild.
TRT_ENGINE_LOCATION=asia-southeast1
TRT_ENGINE_REPOSITORY=model-artifacts
TRT_ENGINE_PACKAGE=rfdetr-keypoint-preview-trt
TRT_ENGINE_VERSION=nvidia-l4-batch16-fp16-trt10.14.1.48-rfdetr1.9.1
TRT_ENGINE_SUBDIR=NVIDIA_L4/batch16
TRT_ENGINE_FILENAME=rfdetr-keypoint-preview.trt
