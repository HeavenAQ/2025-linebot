# The two TensorRT engines baked into the GPU image, published as generic
# artifacts in Artifact Registry. build_pose_engines.py uploads them and
# .github/workflows/cd-motion-analysis.yml downloads them; both read this file.
#
# The pose pipeline is two stages: RF-DETR Medium finds the player, ViTPose++-L
# reads the joints from a crop of them. Each engine only runs on the GPU
# architecture, TensorRT and source-model versions it was built with, so each
# version names all three. Change a version (and trt-engines.sha256) whenever
# any of them changes, then rebuild.
TRT_ENGINE_LOCATION=asia-southeast1
TRT_ENGINE_REPOSITORY=model-artifacts
TRT_ENGINE_SUBDIR=NVIDIA_L4/batch16

# Stage one: person detection.
TRT_DETECTOR_PACKAGE=rfdetr-medium-trt
TRT_DETECTOR_VERSION=nvidia-l4-batch16-fp16-trt10.14.1.48-rfdetr1.9.1
TRT_DETECTOR_FILENAME=rfdetr-medium.trt

# Stage two: 17 COCO keypoints, the COCO expert of the ViTPose++ mixture.
TRT_POSE_PACKAGE=vitpose-plus-large-trt
TRT_POSE_VERSION=nvidia-l4-batch16-fp16-trt10.14.1.48-transformers5.17.0
TRT_POSE_FILENAME=vitpose-plus-large.trt
